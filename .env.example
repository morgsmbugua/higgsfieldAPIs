NODE_ENV=development
PORT=3000
HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:3000
DATA_DIR=./data

# Providers. VIDEO_PROVIDER=mock runs the whole flow for free; "higgsfield" spends real money.
VIDEO_PROVIDER=mock
PAYMENT_PROVIDER=mock

# Only needed when VIDEO_PROVIDER=higgsfield. Keep these out of git and out of logs.
# HIGGSFIELD_API_KEY_ID=
# HIGGSFIELD_API_KEY_SECRET=
# One entry per quality tier. "endpoint" comes from the model's docs page; "usdPerSecond" MUST come from
# Higgsfield's pricing page (the numbers below are illustrative, not real rates).
# HIGGSFIELD_TIERS={"quality":{"endpoint":"bytedance/seedance-2.5/image-to-video","resolution":"720p","generateAudio":false,"usdPerSecond":0.30},"balanced":{"endpoint":"bytedance/seedance-2.5/image-to-video","resolution":"480p","generateAudio":false,"usdPerSecond":0.15},"economy":{"endpoint":"bytedance/seedance-2.5/image-to-video","resolution":"480p","generateAudio":false,"usdPerSecond":0.15}}

# Money. PLACEHOLDER rate: set the real USD -> local currency rate before charging anyone.
CURRENCY=KES
USD_TO_LOCAL=129

# Margin guardrail: provider cost may not exceed this share of the price charged.
MAX_COST_SHARE=0.35

MAX_UPLOAD_BYTES=8388608
JOB_CONCURRENCY=2
